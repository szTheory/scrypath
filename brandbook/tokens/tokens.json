{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "scrypath design tokens",
    "version": "1.35.0",
    "note": "Single source mirrored from the live scrypath_ops daisyUI theme. Hex values; sRGB. Dark values under each token's `dark` key where they differ.",
    "fonts": "Display: Familjen Grotesk · UI/body: Inter · Code: IBM Plex Mono (all SIL OFL 1.1)"
  },
  "color": {
    "primitive": {
      "night":   "#0C0F14",
      "ink":     "#141923",
      "slate":   "#2A3446",
      "mist":    "#B3BDCF",
      "paper":   "#F4F1EA",
      "canvas":  "#FAF7F2",
      "panel":   "#FFFDF8",
      "panel-2": "#F2EEE7",
      "violet-600": "#5B4AD1",
      "violet-500": "#6C5CE7",
      "copper-500": "#C17A3E",
      "copper-600": "#A85D2E"
    },
    "semantic": {
      "bg":          { "light": "#FAF7F2", "dark": "#0C0F14" },
      "surface":     { "light": "#FFFDF8", "dark": "#141923" },
      "surface-2":   { "light": "#F2EEE7", "dark": "#1B2230" },
      "border":      { "light": "#D7D0C4", "dark": "#2A3446" },
      "text":        { "light": "#141923", "dark": "#F4F1EA" },
      "text-muted":  { "light": "#475066", "dark": "#B3BDCF" },
      "text-soft":   { "light": "#6B7388", "dark": "#7F8AA3" },
      "primary":     { "light": "#5B4AD1", "dark": "#6C5CE7" },
      "primary-2":   { "light": "#6C5CE7", "dark": "#5B4AD1" },
      "on-primary":  { "light": "#F4F1EA", "dark": "#F4F1EA" },
      "accent":      { "light": "#A85D2E", "dark": "#C17A3E" },
      "accent-2":    { "light": "#C17A3E", "dark": "#E0B487" },
      "focus":       { "light": "#6C5CE7", "dark": "#6C5CE7" }
    },
    "status": {
      "success": "#4FAE74",
      "info":    "#5CA9E6",
      "warning": "#D9A441",
      "danger":  "#D96262"
    }
  },
  "font": {
    "family": {
      "display": "Familjen Grotesk, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif",
      "sans":    "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif",
      "mono":    "IBM Plex Mono, ui-monospace, Cascadia Code, Menlo, monospace"
    },
    "size": {
      "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem",
      "xl": "1.25rem", "2xl": "1.5rem", "3xl": "2rem", "4xl": "2.5rem",
      "5xl": "3.5rem", "6xl": "4.5rem"
    },
    "leading": { "hero": 1.05, "head": 1.15, "body": 1.6, "code": 1.5 },
    "weight":  { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px",
    "6": "32px", "7": "40px", "8": "48px", "9": "64px", "10": "80px", "11": "96px"
  },
  "radius": { "input": "12px", "card": "16px", "panel": "24px", "pill": "999px" },
  "shadow": {
    "sm": { "light": "0 1px 2px rgba(20,25,35,.06), 0 1px 1px rgba(20,25,35,.04)", "dark": "0 1px 2px rgba(0,0,0,.5)" },
    "md": { "light": "0 4px 12px rgba(20,25,35,.08), 0 1px 2px rgba(20,25,35,.05)", "dark": "0 6px 18px rgba(0,0,0,.55)" },
    "lg": { "light": "0 12px 32px rgba(20,25,35,.12), 0 2px 6px rgba(20,25,35,.06)", "dark": "0 18px 44px rgba(0,0,0,.6)" },
    "glow": { "light": "none", "dark": "0 0 0 1px rgba(108,92,231,.25), 0 8px 30px rgba(108,92,231,.18)" }
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "180ms", "slow": "240ms" },
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
