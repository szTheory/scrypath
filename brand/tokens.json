  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Bricolage Grotesque",
        "system-ui",
        "sans-serif"
      ],
      "$description": "SemiBold (600), Bold (700) and ExtraBold (800), at optical size 96 and width 90, the same settings as the logo. Headlines on dark backgrounds use weight 670, as the dark logo does, in addition to those three."
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Hanken Grotesk",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Weights 400, 600 and 700."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Sometype Mono",
        "ui-monospace",
        "monospace"
      ],
      "$description": "Regular (400) and Medium (500)."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": {
          "value": 80,
          "unit": "ms"
        },
        "$description": "A change the eye must not wait for: hover, press, focus."
      },
      "quick": {
        "$value": {
          "value": 160,
          "unit": "ms"
        },
        "$description": "A small change of one element: a status word swapping, a row highlight."
      },
      "base": {
        "$value": {
          "value": 240,
          "unit": "ms"
        },
        "$description": "A change of a region: a panel opening."
      },
      "advance": {
        "$value": {
          "value": 600,
          "unit": "ms"
        },
        "$description": "An update moving to the next step along the progress line."
      },
      "sting": {
        "$value": {
          "value": 1650,
          "unit": "ms"
        },
        "$description": "The whole logo animation, from the first blink to rest."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "strike": {
        "$value": [
          0.1,
          0.9,
          0.2,
          1
        ],
        "$description": "Fast in, hard stop. For a thing that lands: the slash, a status icon arriving, a key press."
      },
      "resolve": {
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$description": "Quick start, soft landing. For a thing that appears: letters, a new row."
      },
      "settle": {
        "$value": [
          0.3,
          0,
          0.2,
          1
        ],
        "$description": "Slow start, gentle stop. For coming back from an overshoot."
      },
      "sweep": {
        "$value": [
          0.45,
          0,
          0.25,
          1
        ],
        "$description": "Ease in and out. For a highlight or a marker crossing something."
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Accelerates away. For a thing that leaves."
      },
      "advance": {
        "$value": [
          0.45,
          0,
          0.2,
          1
        ],
        "$description": "Ease in and out, a little slower to arrive. For an update moving from one step to the next."
      }
    }
  },
