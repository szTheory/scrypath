# syntax=docker/dockerfile:1
FROM hexpm/elixir:1.19.0-erlang-28.1-debian-bookworm-20260518 AS beam_base

RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends build-essential cmake git curl postgresql-client npm \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

FROM beam_base AS asset_builder

ENV MIX_ENV=dev

COPY mix.exs mix.lock ./
COPY scrypath_ops/mix.exs scrypath_ops/mix.lock ./scrypath_ops/
COPY examples/scrypath_ecommerce/mix.exs examples/scrypath_ecommerce/mix.lock ./examples/scrypath_ecommerce/

# Each project resolves its own lock and compile graph into its project-local
# deps/ and environment-specific _build/ directories. BuildKit caches only Hex
# and Rebar downloads; neither dependency trees nor BEAM output are shared.
RUN --mount=type=cache,target=/root/.hex,sharing=locked \
    --mount=type=cache,target=/root/.cache/rebar3 \
    mix deps.get --check-locked \
 && (cd /app/scrypath_ops && mix deps.get --check-locked) \
 && (cd /app/examples/scrypath_ecommerce && mix deps.get --check-locked)

COPY . .

# Do not let a source checkout's ignored or stale outputs satisfy the build.
RUN rm -rf scrypath_ops/priv/static/assets examples/scrypath_ecommerce/priv/static/assets \
    scrypath_ops/priv/static/cache_manifest.json examples/scrypath_ecommerce/priv/static/cache_manifest.json

RUN (cd /app/scrypath_ops \
      && mix assets.setup \
      && mix assets.build) \
 && (cd /app/examples/scrypath_ecommerce \
      && mix assets.setup \
      && mix assets.build) \
 && test -s /app/scrypath_ops/priv/static/assets/js/app.js \
 && test -s /app/scrypath_ops/priv/static/assets/css/app.css \
 && test -s /app/examples/scrypath_ecommerce/priv/static/assets/js/app.js \
 && test -s /app/examples/scrypath_ecommerce/priv/static/assets/css/app.css

FROM beam_base AS runtime_prod

ENV MIX_ENV=prod \
    PHX_SERVER=true \
    PORT=4000 \
    PGPORT=5432

COPY mix.exs mix.lock ./
COPY scrypath_ops/mix.exs scrypath_ops/mix.lock ./scrypath_ops/
COPY examples/scrypath_ecommerce/mix.exs examples/scrypath_ecommerce/mix.lock ./examples/scrypath_ecommerce/

RUN --mount=type=cache,target=/root/.hex,sharing=locked \
    --mount=type=cache,target=/root/.cache/rebar3 \
    mix deps.get --check-locked \
 && (cd /app/scrypath_ops && mix deps.get --check-locked) \
 && (cd /app/examples/scrypath_ecommerce && mix deps.get --check-locked)

COPY --exclude=**/config/dev.exs . .

# Replace source-tree static output with output generated by the isolated dev
# builder. Other static files (favicons, logos and robots.txt) are retained.
RUN rm -rf scrypath_ops/priv/static examples/scrypath_ecommerce/priv/static
COPY --from=asset_builder /app/scrypath_ops/priv/static /app/scrypath_ops/priv/static
COPY --from=asset_builder /app/examples/scrypath_ecommerce/priv/static /app/examples/scrypath_ecommerce/priv/static

RUN mix compile --warnings-as-errors \
 && (cd /app/scrypath_ops && mix compile --warnings-as-errors) \
 && (cd /app/examples/scrypath_ecommerce && mix compile --warnings-as-errors) \
 && (cd /app/scrypath_ops && mix phx.digest) \
 && (cd /app/examples/scrypath_ecommerce && mix phx.digest)

WORKDIR /app/examples/scrypath_ecommerce

EXPOSE 4000

CMD ["sh", "./docker-entrypoint.sh"]

FROM beam_base AS runtime_test

ENV MIX_ENV=test \
    PHX_SERVER=true \
    PORT=4002 \
    PGPORT=5432 \
    SCRYPATH_MEILISEARCH_URL=http://meilisearch:7700

COPY mix.exs mix.lock ./
COPY scrypath_ops/mix.exs scrypath_ops/mix.lock ./scrypath_ops/
COPY examples/scrypath_ecommerce/mix.exs examples/scrypath_ecommerce/mix.lock ./examples/scrypath_ecommerce/

RUN --mount=type=cache,target=/root/.hex,sharing=locked \
    --mount=type=cache,target=/root/.cache/rebar3 \
    mix deps.get --check-locked \
 && (cd /app/scrypath_ops && mix deps.get --check-locked) \
 && (cd /app/examples/scrypath_ecommerce && mix deps.get --check-locked)

COPY --exclude=**/config/dev.exs . .

RUN rm -rf scrypath_ops/priv/static examples/scrypath_ecommerce/priv/static
COPY --from=asset_builder /app/scrypath_ops/priv/static /app/scrypath_ops/priv/static
COPY --from=asset_builder /app/examples/scrypath_ecommerce/priv/static /app/examples/scrypath_ecommerce/priv/static

RUN mix compile --warnings-as-errors \
 && (cd /app/scrypath_ops && mix compile --warnings-as-errors) \
 && (cd /app/examples/scrypath_ecommerce && mix compile --warnings-as-errors) \
 && test -s /app/scrypath_ops/priv/static/assets/js/app.js \
 && test -s /app/scrypath_ops/priv/static/assets/css/app.css \
 && test -s /app/examples/scrypath_ecommerce/priv/static/assets/js/app.js \
 && test -s /app/examples/scrypath_ecommerce/priv/static/assets/css/app.css

WORKDIR /app/examples/scrypath_ecommerce

EXPOSE 4002

CMD ["sh", "./docker-entrypoint.sh"]
