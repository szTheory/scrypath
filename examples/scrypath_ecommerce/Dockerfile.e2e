# syntax=docker/dockerfile:1
ARG PLAYWRIGHT_VERSION=1.60.0
# Digest of the multi-arch index for v1.60.0-noble; bump it together with PLAYWRIGHT_VERSION.
ARG PLAYWRIGHT_IMAGE_DIGEST=sha256:9bd26ad900bb5e0f4dee75839e957a89ae89c2b7ab1e76050e559790e946b948
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble@${PLAYWRIGHT_IMAGE_DIGEST}

WORKDIR /app/examples/scrypath_ecommerce

COPY examples/scrypath_ecommerce/package.json examples/scrypath_ecommerce/package-lock.json ./
RUN npm ci

WORKDIR /app
COPY . .

WORKDIR /app/examples/scrypath_ecommerce
CMD ["bash", "./docker-playwright.sh"]
