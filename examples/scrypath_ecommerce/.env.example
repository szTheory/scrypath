# Per-demo Docker host-port "lanes".
#
# Docker Compose auto-loads this file. Copy it to `.env` and bump the numbers when you
# run several library demos at once so nothing collides on the host.
#
# WEB_PORT is the browser URL for make docker-dev and make up. PG_PORT and MEILI_PORT
# are only published by host-tooling flows that include compose.host-ports.yaml
# (make dev, make infra, make infra-pg). The default Docker dev stack keeps
# Postgres and Meilisearch inside the Compose network.
#
# Suggested convention — give each demo a base and offset every port by +10:
#   scrypath_ecommerce : WEB=4002  PG=5432  MEILI=7700   (defaults below)
#   demo-b             : WEB=4012  PG=5442  MEILI=7710
#   demo-c             : WEB=4022  PG=5452  MEILI=7720

WEB_PORT=4002
PG_PORT=5432
MEILI_PORT=7700
