{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": false,
    "text_mode": false,
    "research_before_questions": true,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "_auto_chain_active": false,
    "use_worktrees": true
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "resolve_model_ids": "omit",
  "runtime": "codex",
  "model_overrides": {
    "gsd-planner": "gpt-6-sol",
    "gsd-phase-researcher": "gpt-6-sol",
    "gsd-project-researcher": "gpt-6-sol",
    "gsd-plan-checker": "gpt-6-sol",
    "gsd-domain-researcher": "gpt-6-sol",
    "gsd-executor": "gpt-6-luna",
    "gsd-verifier": "gpt-6-luna",
    "gsd-code-reviewer": "gpt-6-luna",
    "gsd-nyquist-auditor": "gpt-6-luna",
    "gsd-integration-checker": "gpt-6-luna",
    "gsd-security-auditor": "gpt-6-sol"
  }
}
