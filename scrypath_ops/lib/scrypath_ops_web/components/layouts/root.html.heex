<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <.live_title default="Scrypath" suffix=" · Scrypath">
      {assigns[:page_title]}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={"/assets/css/app.css?v=#{ScrypathOpsWeb.AssetPlug.asset_version("assets/css/app.css")}"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={"/assets/js/app.js?v=#{ScrypathOpsWeb.AssetPlug.asset_version("assets/js/app.js")}"}
    >
    </script>
    <script>
      (() => {
        const themeKey = "phx:theme";
        const normalizeTheme = (theme) =>
          theme === "light" || theme === "dark" ? theme : "system";

        const readStoredTheme = () => {
          try {
            return normalizeTheme(localStorage.getItem(themeKey));
          } catch (_error) {
            return "system";
          }
        };

        let currentPreference = readStoredTheme();

        const effectiveTheme = () => {
          if (currentPreference === "light" || currentPreference === "dark") {
            return currentPreference;
          }

          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };

        const syncThemeButtons = () => {
          document.querySelectorAll("[data-phx-theme]").forEach((button) => {
            const selected = button.dataset.phxTheme === currentPreference;
            button.setAttribute("aria-pressed", selected ? "true" : "false");
            button.setAttribute("data-theme-selected", selected ? "true" : "false");
          });
        };

        const syncThemeMeta = () => {
          document.documentElement.setAttribute("data-theme-effective", effectiveTheme());
          document.documentElement.setAttribute("data-theme-preference", currentPreference);
          syncThemeButtons();
        };

        const setTheme = (theme, persist = true) => {
          currentPreference = normalizeTheme(theme);

          if (persist) {
            try {
              if (currentPreference === "system") {
                localStorage.removeItem(themeKey);
              } else {
                localStorage.setItem(themeKey, currentPreference);
              }
            } catch (_error) {
              // Keep the current page usable when browser storage is denied.
            }
          }

          if (currentPreference === "system") {
            document.documentElement.removeAttribute("data-theme");
          } else {
            document.documentElement.setAttribute("data-theme", currentPreference);
          }

          syncThemeMeta();
        };

        setTheme(currentPreference, false);

        window.addEventListener("storage", (e) => {
          if (e.key === themeKey || e.key === null) {
            setTheme(e.newValue, false);
          }
        });

        window.addEventListener("phx:set-theme", (e) => {
          const button = e.target.closest("[data-phx-theme]");
          if (button) setTheme(button.dataset.phxTheme);
        });

        window.addEventListener("phx:page-loading-stop", () => syncThemeMeta());

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", () => syncThemeMeta());

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => syncThemeMeta(), { once: true });
        } else {
          syncThemeMeta();
        }
      })();
    </script>
  </head>
  <body>
    <%!-- flash_group: primary operator chrome renders `<.flash_group>` from `Layouts.app/1` --%>
    {@inner_content}
  </body>
</html>
